# Optional NLP/LLM extractor configuration.
# Copy this file to .env and fill your own key. Do not commit .env.

LLM_API_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-key-here
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# Multimodal API configuration (image/video → event extraction via vision model)
# You can also configure these from the Streamlit frontend (persisted to JSON).
MULTIMODAL_API_URL=https://api.moonshot.cn/v1
MULTIMODAL_API_KEY=sk-your-moonshot-key-here
MULTIMODAL_MODEL=kimi-k2.6
MULTIMODAL_TEMPERATURE=0.1
MULTIMODAL_MAX_TOKENS=2000
